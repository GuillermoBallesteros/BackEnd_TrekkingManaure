# Copiar a .env y completar los valores. No versionar .env.
# Los SECRETOS (DB_PASSWORD, ADMIN_PASSWORD, JWT_SECRET, HEALTH_ENCRYPTION_KEY) vienen vacíos a propósito: la API no
# arranca hasta que se rellenen, y rechaza valores que contengan "cambiar" o los ejemplos antiguos (en prod, siempre).
# Obligatorias en todos los perfiles (la API no arranca sin ellas): DB_*, ADMIN_*, CORS_ORIGIN, JWT_SECRET, HEALTH_ENCRYPTION_KEY.
DB_NAME=trekking
DB_USER=trekking
# Secreto: dejar vacío NO arranca. Generar: openssl rand -hex 32
DB_PASSWORD=
ADMIN_EMAIL=admin@ejemplo.com
# Secreto (prod: mínimo 12 caracteres). Generar: openssl rand -base64 18   (o -hex 16)
ADMIN_PASSWORD=
# En producción: origen HTTPS exacto del front, p. ej. https://carrera.ejemplo.com (sin "*").
CORS_ORIGIN=http://localhost:5173
# Secreto: mínimo 48 caracteres aleatorios (prod lo exige). Generar: openssl rand -base64 48
JWT_SECRET=

# Clave AES-256 que cifra la ficha de salud: formato version:base64 de 32 bytes. La API no arranca sin ella.
# Generar: python -c "import os,base64;print('1:'+base64.b64encode(os.urandom(32)).decode())"  (o: echo "1:$(openssl rand -base64 32)")
# Perder la clave hace ilegibles los datos de salud: guardar copia aparte. No subir a git.
# Secreto, vacío hasta generarla (la API no arranca sin ella).
HEALTH_ENCRYPTION_KEY=
# Opcional, para rotar: claves anteriores (version:base64, separadas por coma) que solo sirven para descifrar.
#HEALTH_ENCRYPTION_KEY_ANTERIORES=
# Atributo Secure de la cookie de sesion (true por defecto; los navegadores lo aceptan en localhost).
COOKIE_SECURE=true

# --- Avisos por correo con Brevo (HU-N15); todas opcionales mientras BREVO_ACTIVO=false ---
# true en producción. En true la API no arranca sin BREVO_API_KEY.
BREVO_ACTIVO=false
# Secreto: Brevo > SMTP & API > API Keys > Generate (empieza por xkeysib-). Nunca en el repositorio ni en VITE_*.
BREVO_API_KEY=
# Remitente verificado en Brevo (dominio manaurevive.com autenticado).
BREVO_REMITENTE_CORREO=manaureecoturisticointernacional@manaurevive.com
BREVO_REMITENTE_NOMBRE=ManaureVive
# Id de la plantilla de Brevo por tipo de aviso; 0 apaga ese tipo.
BREVO_PLANTILLA_PAGO_3_DIAS=0
BREVO_PLANTILLA_PAGO_1_DIA=0
BREVO_PLANTILLA_PAGO_HOY=0
BREVO_PLANTILLA_PAGO_VENCIDO=0
BREVO_PLANTILLA_PAGO_APROBADO=0
BREVO_PLANTILLA_PAGO_RECHAZADO=0
BREVO_PLANTILLA_EVENTO_MANANA=0

# --- Solo producción (docker-compose.prod.yml) ---
# OBLIGATORIA en prod: dominio público que ya apunta por DNS al VPS (p. ej. manaurevive.com).
# Sitio, panel y API comparten este dominio (Caddy envía /api a la API): en prod CORS_ORIGIN debe ser
# https://<DOMAIN>, COOKIE_SECURE=true y el front se construye con VITE_API_URL=https://<DOMAIN>.
# En local, DOMAIN=localhost hace que Caddy emita un certificado interno.
DOMAIN=tudominio.com
# Carpeta del repositorio del front, relativa a esta (por defecto ../../TrekkingManaure).
#FRONT_DIR=../../TrekkingManaure
#VITE_CLOUDINARY_CLOUD_NAME=meoo7p5s

# --- Copias de seguridad (scripts/backup.sh); todas opcionales ---
# Copias locales a conservar (por defecto 7).
#BACKUP_KEEP=7
# Comando opcional para enviar la copia fuera del servidor; recibe la ruta del archivo en $1. Ejemplo:
#BACKUP_UPLOAD_CMD=rclone copyto "$1" remoto:manaure-backups/$(basename "$1")
